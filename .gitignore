# Nothing here is a build artefact of a committed file, but the scripts are
# sometimes imported by hand; keep bytecode out of the history.
__pycache__/
*.pyc

# Figure images are regenerated by the `figures/*.sh` wrappers from committed
# data; keep the binaries themselves out of the history.
figures/*.png
figures/*.jpg
figures/*.jpeg

# CDSE/SLC secrets for code/lumo_slc_ranged_read.py + code/lumo_burst_cache_audit.py:
# a local copy of the tower's backend/.env, never committed.
secrets/
